# ContainerFile — the Great Falls Tool Bus platform image (TIN-2541, TIN-3815 S0).
#
# ONE immutable image, THREE stable process names: `web`, `worker`, and
# `migrator` (spec §6). They are installed as links onto the single dispatcher
# scripts/platform-entrypoint.mjs, so a Deployment or Job picks a process
# boundary by executable name. `migrator` was filled in by TIN-3817 S1 (the
# real applier) and `worker` by TIN-3817 S3 (the transactional-outbox
# dispatcher) — the image contract S0 declared is unchanged.
#
# ADAPTER SELECTION (ADR 0010 Amendment 1 item 2). This image is built with
# ADAPTER=node so svelte.config.js selects @sveltejs/adapter-node. The default
# no-ADAPTER build stays adapter-static as the local/CI fallback and never
# touches this file — `svelte.config.js` is deliberately NOT changed.
#
# adapter-node is a committed devDependency (TIN-2543, MassageIthaca parity
# @sveltejs/adapter-node ^5.5.7): the frozen-lockfile install below installs it
# directly. The DEFAULT build stays adapter-static and never imports it — only
# ADAPTER=node (set in this builder) selects adapter-node. See
# docs/deploy/oncluster-container-readiness.md.
#
# CI does NOT use this file (TIN-2543): GFTB's ARC pool has no `tinyland-dind`
# /buildx runner, so .github/workflows/container-ghcr.yml builds the on-cluster
# image DAEMONLESS via Nix (nix/oci-image.nix -> dockerTools.streamLayeredImage,
# `just container-image-publish`) on the shared `tinyland-nix` runner. This
# ContainerFile is retained as the LOCAL podman/docker convenience (and mirror
# of the same adapter-node -> `node build/index.js` shape).
#
# Usage (local, on a machine that HAS a Docker/podman daemon):
#   podman build -f ContainerFile -t greatfallstoolbus.org:local .
#   podman run --rm -p 3000:3000 greatfallstoolbus.org:local
#
# Override the base image to dodge Docker Hub rate limits / use a mirror:
#   podman build --build-arg NODE_IMAGE=registry.example.com/node:22-alpine ...

ARG NODE_IMAGE=docker.io/node:22-alpine
ARG PNPM_VERSION=10.13.1

# --- pnpm base -------------------------------------------------------------
FROM ${NODE_IMAGE} AS pnpm-base
ARG PNPM_VERSION
RUN corepack enable && \
    for attempt in 1 2 3 4 5; do \
      corepack prepare "pnpm@${PNPM_VERSION}" --activate && break; \
      status=$?; \
      if [ "$attempt" = "5" ]; then exit "$status"; fi; \
      echo "corepack prepare pnpm@${PNPM_VERSION} failed; retrying"; \
    done

# --- builder ---------------------------------------------------------------
FROM pnpm-base AS builder
ARG BUILD_COMMIT_SHA=unknown
ARG BUILD_COMMIT_REF=unknown
ARG BUILD_DATE

RUN apk add --no-cache git python3 make g++ jq bash

WORKDIR /app

# Install the committed, frozen dependency set first (cache-friendly layer).
# adapter-node is a committed devDependency (TIN-2543), so the frozen-lockfile
# install brings it in — no out-of-band mutation of the lockfile.
# scripts/ must land before the install: the root `prepare` hook
# (scripts/build-tinyvectors.mjs) runs at the end of pnpm install and builds
# the registry-pinned tinyvectors dist from source.
COPY package.json pnpm-lock.yaml .npmrc ./
COPY scripts/ ./scripts/
RUN pnpm install --frozen-lockfile

# Copy config + sources.
COPY svelte.config.js vite.config.ts tsconfig.json eslint.config.ts drizzle.config.ts server.js ./
COPY src/ ./src/
COPY static/ ./static/
COPY drizzle/ ./drizzle/

# ADAPTER=node makes svelte.config.js select @sveltejs/adapter-node; output is
# a Node server under build/ (entry build/index.js). Image optimization is
# skipped here — the committed static/image-manifest.json fallback carries it,
# exactly like `pnpm run build` does off the `just build` image prestep.
ENV ADAPTER=node
ENV BUILD_COMMIT_SHA=${BUILD_COMMIT_SHA}
ENV BUILD_COMMIT_REF=${BUILD_COMMIT_REF}
ENV BUILD_DATE=${BUILD_DATE}
RUN pnpm run build

# The migrator payload (TIN-3817 S1). Mirrors `just db-migrator-bundle`: one
# ESM file with `pg` inlined, because the production stage below carries no
# node_modules. The createRequire banner is required — pg is CommonJS and
# reaches node builtins through require(), which bare ESM output cannot do.
RUN pnpm exec esbuild src/lib/server/db/migrate.ts \
      --bundle --platform=node --format=esm --target=node22 \
      --outfile=build/migrator.mjs \
      --external:pg-native --external:cloudflare:sockets \
      --tsconfig-raw='{}' \
      --banner:js="import { createRequire as __gftbCreateRequire } from 'node:module'; const require = __gftbCreateRequire(import.meta.url);"

# The worker payload (TIN-3817 S3). Mirrors `just worker-bundle`: same one-file
# contract and the same createRequire banner, with drizzle-orm inlined
# alongside pg.
RUN pnpm exec esbuild src/lib/server/worker.ts \
      --bundle --platform=node --format=esm --target=node22 \
      --outfile=build/worker.mjs \
      --external:pg-native --external:cloudflare:sockets \
      '--alias:$lib=./src/lib' \
      --tsconfig-raw='{}' \
      --banner:js="import { createRequire as __gftbCreateRequire } from 'node:module'; const require = __gftbCreateRequire(import.meta.url);"

# --- production ------------------------------------------------------------
FROM pnpm-base AS production
ARG BUILD_COMMIT_SHA=unknown
ARG BUILD_COMMIT_REF=unknown
ARG BUILD_DATE

LABEL org.opencontainers.image.source="https://github.com/Great-Falls-Tool-Bus/greatfallstoolbus.org"
LABEL org.opencontainers.image.revision="${BUILD_COMMIT_SHA}"
LABEL org.opencontainers.image.ref.name="${BUILD_COMMIT_REF}"
LABEL org.opencontainers.image.created="${BUILD_DATE}"

ENV NODE_OPTIONS="--max-old-space-size=512"

RUN apk add --no-cache dumb-init curl

WORKDIR /app

# Non-root runtime user. Copy build output + node_modules with the target
# ownership set on COPY (a recursive chown of /app would rewrite node_modules
# into a large extra layer — the MassageIthaca lesson).
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001 -G nodejs

COPY --from=builder --chown=nodejs:nodejs /app/build ./build
COPY --from=builder --chown=nodejs:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=nodejs:nodejs /app/package.json ./package.json
COPY --from=builder --chown=nodejs:nodejs /app/server.js ./server.js
COPY --from=builder --chown=nodejs:nodejs /app/scripts/platform-entrypoint.mjs ./scripts/platform-entrypoint.mjs
# /bin/migrator reads these and hashes their EXACT bytes against the ledger, so
# the migrations in the image are the ones in the commit (TIN-3817 S1).
COPY --from=builder --chown=nodejs:nodejs /app/drizzle ./drizzle

# One dispatcher, three stable process names. Node keeps argv[1] as the LINK
# path rather than the realpath, so `basename(argv[1])` is what selects the
# role — see scripts/platform-entrypoint.mjs.
RUN chmod 0755 /app/scripts/platform-entrypoint.mjs && \
    ln -s /app/scripts/platform-entrypoint.mjs /usr/local/bin/web && \
    ln -s /app/scripts/platform-entrypoint.mjs /usr/local/bin/worker && \
    ln -s /app/scripts/platform-entrypoint.mjs /usr/local/bin/migrator

USER nodejs

EXPOSE 3000

ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=3000
# The dispatcher is installed outside build/, so hand it the absolute path to
# the web entrypoint rather than letting it guess. This is server.js, NOT
# adapter-node's own generated build/index.js (TIN-3959): server.js wraps the
# generated build/handler.js with the cache-header fix documented at its top
# — build/index.js's stock sirv layers ship prerendered HTML with no
# Cache-Control and an epoch Last-Modified (mtimes are zeroed for
# reproducible builds), so returning visitors never revalidate.
ENV GFTB_WEB_ENTRYPOINT=/app/server.js
# Same reason, for the migrator (TIN-3817 S1).
ENV GFTB_MIGRATOR_ENTRYPOINT=/app/build/migrator.mjs
ENV GFTB_MIGRATIONS_DIR=/app/drizzle
# Same reason, for the worker (TIN-3817 S3). DATABASE_URL and GFTB_TENANT_ID
# are runtime NAMES supplied by great-falls-tool-bus-infra — never values here.
ENV GFTB_WORKER_ENTRYPOINT=/app/build/worker.mjs

# adapter-node serves the site at `/`; the readiness probe hits `/`.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -fsS http://localhost:3000/ >/dev/null || exit 1

# Default process is `web`. Select another boundary by overriding the command:
#   podman run --rm greatfallstoolbus.org:local migrator --help
ENTRYPOINT ["dumb-init", "--"]
CMD ["web"]
