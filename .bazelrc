# greatfallstoolbus.org Bazel Configuration
#
# Bazel 8 + Bzlmod. Mirrors elders.tinyland.dev's two-registry chain:
# tinyland-inc/bazel-registry first, then BCR. Site build remains
# `pnpm run build`; Bazel exists for module-graph integrity proofs.

common --enable_bzlmod
# Supply-chain hardening: pin tinyland-inc/bazel-registry to an immutable
# commit SHA instead of the mutable `main` ref so module metadata
# (MODULE.bazel + source.json) cannot silently change under us. Bump the SHA
# deliberately, in its own commit, with the refresh one-liner:
#   sed -i '' "s|bazel-registry/[0-9a-f]\{40\}|bazel-registry/$(gh api repos/tinyland-inc/bazel-registry/commits/main --jq .sha)|" .bazelrc
#   bazelisk mod graph   # regenerates MODULE.bazel.lock
# The registry README states the rule this repo follows: "A SHA bump must
# land alongside a `MODULE.bazel.lock` refresh in the same commit." Bumping
# the SHA without re-committing the regenerated lock is a broken change.
#
# NOTE (TIN-3857): this SHA is origin/main of tinyland-inc/bazel-registry as
# of the .bazelversion 8.2.1 convergence PR, taken BEFORE that PR merged, so
# the commit pinned below still records .bazelversion 8.1.1. Re-pin to the
# post-merge main SHA once that PR lands -- and in the SAME commit regenerate
# MODULE.bazel.lock (the re-pin rewrites every registry URL key in it, ~161
# keys) and re-read the registry's .bazelversion to confirm it then records
# the estate-bazelversion value below.
#
# estate-bazelversion: 8.2.1
#   The estate-wide Bazel version, as set by the companion registry PR
#   (tinyland-inc/bazel-registry, branch chore/tin-3857-bazelversion-8.2.1).
#   The registry commit pinned below is NOT yet that value: it still records
#   8.1.1. The post-merge re-pin described above is what makes the pinned
#   commit agree with this line. scripts/scaffold-doctor-boundary.sh asserts
#   root .bazelversion equals this value (offline). See "LIMITS" in that
#   script: it proves this repo has not drifted from the value recorded here,
#   NOT that the pinned registry commit records the same value -- today it
#   does not, and reconciling that is the re-pin step above.
#
# The estate-wide Bazel version SSOT, the two-registry chain, and this pin
# convention are specified in that registry's own docs, not here (this link
# tracks the registry's default branch; it resolves once the companion
# registry PR that adds the doc lands, and does not need re-pinning):
#   https://github.com/tinyland-inc/bazel-registry/blob/main/docs/bazel-adoption-v0.md
common --registry=https://raw.githubusercontent.com/tinyland-inc/bazel-registry/6f4d35d266fdbc66cb0ad98e02680bbd9a296d0c
# bcr stays as a secondary registry; the Tinyland registry stays first so
# in-house Bazel modules resolve before falling through to bcr.bazel.build.
common --registry=https://bcr.bazel.build

# Build performance
build --jobs=auto
build --worker_sandboxing
build --disk_cache=~/.cache/bazel-greatfallstoolbus
build --keep_going
build --show_timestamps

# Flywheel cache + REAPI behavior lives in .bazelrc.flywheel, but endpoint
# authority lives in scripts/gloriousflywheel-bazel.sh. The wrapper passes
# --remote_cache and optional --remote_executor explicitly from validated env.
# See docs/CI-SCHEMA.md §5 for the contract.
try-import %workspace%/.bazelrc.flywheel

# rules_ts: skip lib check is required for SvelteKit-style declaration files.
build --@aspect_rules_ts//ts:skipLibCheck=always
build --spawn_strategy=sandboxed,worker,local

# CI base config. The cache-backed enrollment lane (ci.yml cache_backed: true)
# layers `--config=ci-cached` on top of this. Empty the disk cache in CI so a
# green cache-backed build proves the REMOTE shared cache rather than an
# incidental local-disk hit (TIN-2119 real-attach discipline).
build:ci --disk_cache=
build:ci --remote_retries=3
build:ci --jobs=auto
build:ci --color=no
build:ci --curses=no
build:ci --show_progress_rate_limit=30
build:ci --noshow_loading_progress

# ci-cached: endpoint-free shared-cache behavior for the cache_backed lane,
# mirroring tinyland-inc/ci-templates bazelrc/ci-cached.bazelrc. The workflow
# supplies --remote_cache and upload policy at invocation after validating
# BAZEL_REMOTE_CACHE via scripts/cache-attachment-contract.sh. CACHE-FIRST only
# (TIN-1997 Option D): this never selects a remote executor.
build:ci-cached --config=ci
build:ci-cached --remote_upload_local_results=false
build:ci-cached --remote_download_minimal
build:ci-cached --remote_timeout=60

# Test output
test --test_output=errors
test --test_summary=detailed
test --test_verbose_timeout_warnings
test --test_timeout=120,600,1800,3600

try-import %workspace%/user.bazelrc
