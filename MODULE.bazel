"""
greatfallstoolbus.org - Bazel Module Configuration

App-stateful SvelteKit consumer of six @tummycrypt/* packages produced by
tinyland-inc/bazel-registry. TIN-2881 makes this Bzlmod graph their sole source:
BUILD.bazel graph-links each public :pkg target with npm_link_package, while
package.json and pnpm-lock.yaml carry no first-party source specifier. Just
entrypoints hydrate those graph outputs only when a Node-compatible layout is
required; Flywheel build/test paths remain the canonical endpoint-free Bazel
proof surfaces.

Stock module picks (replace per-site as needed):

- tummycrypt_tinyland_color_utils — runtime color leaf (zero deps).
- tummycrypt_vite_plugin_a11y      — build-time WCAG scan plugin.
- tummycrypt_vite_plugin_skeleton_colors — Skeleton-4 color generator.
- tummycrypt_tinyvectors            — animated vector blob backgrounds.
- tummycrypt_tinyland_auth          — Member v0 auth core (TIN-3817 S2 pin).
- tummycrypt_tinyland_auth_pg       — tenant-scoped PG storage adapter (S2 pin).

After cloning from this template:
  1. Update `module(name = ...)` to your_site_underscored.
  2. Run `scripts/rebrand.sh <site.example.com>` to sed brand strings.
  3. `bazelisk mod graph` should succeed before first commit.
"""

module(
    name = "greatfallstoolbus_org",
    version = "0.0.1",
    compatibility_level = 1,
)

# Core
bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "aspect_bazel_lib", version = "2.22.5")
bazel_dep(name = "rules_pkg", version = "1.1.0")

# JS/TS toolchain (Aspect)
bazel_dep(name = "rules_nodejs", version = "6.7.3")
bazel_dep(name = "aspect_rules_js", version = "2.9.1")
bazel_dep(name = "aspect_rules_ts", version = "3.8.4")
bazel_dep(name = "aspect_rules_swc", version = "2.6.1")

# First-party package authority: exact modules from tinyland-inc/bazel-registry.
# package.json MUST NOT name them; `just inhouse-package-parity` proves each
# bazel_dep has a matching BUILD.bazel npm_link_package :pkg edge.
bazel_dep(name = "tummycrypt_tinyland_color_utils", version = "0.2.3")
bazel_dep(name = "tummycrypt_vite_plugin_a11y", version = "0.2.2")
bazel_dep(name = "tummycrypt_vite_plugin_skeleton_colors", version = "0.2.2")
bazel_dep(name = "tummycrypt_tinyvectors", version = "0.3.6")

# Member v0 auth spine (TIN-3817 S2). These Bzlmod pins are load-bearing:
# the PG adapter's peer range accepts nothing newer than auth 0.3.x, and no
# adapter exists for auth >= 0.4.0 (executable-slices spec §0.7). Keep the pair
# in lockstep and graph-link both public :pkg targets; there is no npm fallback.
bazel_dep(name = "tummycrypt_tinyland_auth", version = "0.3.3")
bazel_dep(name = "tummycrypt_tinyland_auth_pg", version = "0.2.4")

# Node 22.13.1
node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version = "22.13.1")

# pnpm 10.13.1
pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm")
pnpm.pnpm(
    name = "pnpm",
    pnpm_version = "10.13.1",
)
use_repo(pnpm, "pnpm")

# Third-party npm graph via pnpm-lock.yaml. Repo name "npm" matches the
# Aspect convention. First-party @tummycrypt/@tinyland packages are deliberately
# absent: their sole source is the Bzlmod deps above and BUILD.bazel :pkg links.
npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    npmrc = "//:.npmrc",
    pnpm_lock = "//:pnpm-lock.yaml",
    data = [
        "//:package.json",
        "//:pnpm-workspace.yaml",
    ],
)
use_repo(npm, "npm")

# TypeScript 6.0.3 — must match package.json exactly (rules_ts cannot parse
# caret ranges, and house-stack-contract.test.ts fails on any drift between
# the two files). 6.0.3 postdates rules_ts 3.8.4's built-in version map, so
# the npm dist integrity is pinned explicitly.
rules_ts_ext = use_extension("@aspect_rules_ts//ts:extensions.bzl", "ext")
rules_ts_ext.deps(
    ts_version = "6.0.3",
    ts_integrity = "sha512-y2TvuxSZPDyQakkFRPZHKFm+KKVqIisdg9/CZwm9ftvKXLP8NRWj38/ODjNbr43SsoXqNuAisEf1GdCxqWcdBw==",
)
use_repo(rules_ts_ext, "npm_typescript")

# SWC for any future ts_project targets
swc = use_extension("@aspect_rules_swc//swc:extensions.bzl", "swc")
swc.toolchain(
    name = "swc",
    swc_version = "v1.10.12",
)
use_repo(swc, "swc_toolchains")

register_toolchains("@swc_toolchains//:all")
