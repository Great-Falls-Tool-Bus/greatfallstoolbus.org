"""
Root BUILD.bazel for greatfallstoolbus.org.

The SvelteKit static site still has ergonomic pnpm-backed Justfile recipes, but
Bazel owns finite graphable targets for Flywheel cache/RBE proof surfaces.
"""

load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_run_binary", "js_test")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//:eslint/package_json.bzl", eslint_bin = "bin")
load("@npm//:prettier/package_json.bzl", prettier_bin = "bin")
load("@npm//:vitest/package_json.bzl", vitest = "bin")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//:gitleaks_test.bzl", "gitleaks_test")

npm_link_all_packages(name = "node_modules")

filegroup(
    name = "app_srcs",
    srcs = glob(
        [
            "src/**",
            "static/**",
            "scripts/**/*.mts",
            "scripts/bazel/**/*.mjs",
            # Generated + hand-written migrations (TIN-3817 S1). Enrolled so a
            # change to a migration invalidates //:unit_tests — the ledger
            # assertions in src/lib/server/db/migrations.test.ts read this tree,
            # and a cached green from before the edit would defeat them.
            "drizzle/**",
        ],
        allow_empty = True,
    ) + [
        ".npmrc",
        # Read by src/lib/server/db/migrations.test.ts, which asserts that no
        # recipe invokes `drizzle push`.
        "Justfile",
        "drizzle.config.ts",
        "vitest.integration.config.ts",
        # The platform process dispatcher (TIN-3815 S0). The scripts/ glob above
        # only reaches *.mts and scripts/bazel/*.mjs, so this file must be
        # enrolled by explicit label or //:unit_tests silently loses
        # scripts/platform-entrypoint.test.mts's subject.
        "scripts/platform-entrypoint.mjs",
        "package.json",
        "playwright.config.ts",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "svelte.config.js",
        "tsconfig.json",
        "vite.config.ts",
        "vitest.config.ts",
    ],
)

filegroup(
    name = "e2e_srcs",
    srcs = glob(
        ["e2e/**"],
        allow_empty = True,
    ),
)

# The v4 validation action carries its own exact source capsule. Secret
# scanning is therefore a hermetic Bazel test inside the same REAPI action,
# not a second runner job or a local/hosted fallback.
filegroup(
    name = "current_source_secret_scan_srcs",
    srcs = [
        ".bazelrc",
        ".bazelversion",
        ".envrc",
        ".gitignore",
        ".gitleaks.toml",
        ".npmrc",
        ".nvmrc",
        ".prettierignore",
        ".prettierrc",
        "AGENTS.md",
        "BUILD.bazel",
        "CLAUDE.md",
        "ContainerFile",
        "Justfile",
        "LICENSE",
        "MODULE.bazel",
        "MODULE.bazel.lock",
        "README.md",
        "drizzle.config.ts",
        "eslint.config.ts",
        "flake.lock",
        "flake.nix",
        "gitleaks_test.bzl",
        "multitool.lock.json",
        "package.json",
        "playwright.config.ts",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "svelte.config.js",
        "tinyland.repo.json",
        "tsconfig.json",
        "vite.config.ts",
        "vitest.config.ts",
        "vitest.integration.config.ts",
    ] + glob(
        [
            ".agents/**",
            ".github/**",
            "docs/**",
            "drizzle/**",
            "e2e/**",
            "nix/**",
            "scripts/**",
            "src/**",
            "static/**",
        ],
        allow_empty = True,
        exclude = [
            "**/.DS_Store",
            "**/__pycache__/**",
        ],
    ),
)

gitleaks_test(
    name = "current_source_secret_scan_test",
    timeout = "short",
    srcs = [":current_source_secret_scan_srcs"],
    config = ".gitleaks.toml",
)

js_binary(
    name = "sveltekit_sync_bin",
    data = [":node_modules"],
    entry_point = "scripts/bazel/run-sveltekit-sync.mjs",
)

js_run_binary(
    name = "sveltekit_types",
    srcs = [":app_srcs"],
    out_dirs = [".svelte-kit"],
    tool = ":sveltekit_sync_bin",
)

js_binary(
    name = "svelte_check_bin",
    data = [":node_modules"],
    entry_point = "scripts/bazel/run-svelte-check.mjs",
)

js_test(
    name = "svelte_check_test",
    timeout = "long",
    data = [
        ":app_srcs",
        ":node_modules",
        ":sveltekit_types",
    ],
    entry_point = "scripts/bazel/run-svelte-check.mjs",
)

# Exact, read-only lint target selected by the v4 ActionPlan.
eslint_bin.eslint_test(
    name = "eslint_test",
    timeout = "moderate",
    args = ["."],
    data = [
        "eslint.config.ts",
        ":app_srcs",
        ":node_modules",
        ":sveltekit_types",
    ],
)

# Exact, read-only format target selected by the v4 ActionPlan.
prettier_bin.prettier_test(
    name = "prettier_check_test",
    timeout = "short",
    args = [
        "--check",
        ".",
    ],
    data = [
        ".prettierignore",
        ".prettierrc",
        ":app_srcs",
        ":node_modules",
    ],
)

js_binary(
    name = "vite_build_bin",
    data = [":node_modules"],
    entry_point = "scripts/bazel/run-vite-build.mjs",
)

js_run_binary(
    name = "build",
    srcs = [
        ":app_srcs",
        ":sveltekit_types",
    ],
    out_dirs = ["build"],
    patch_node_fs = False,
    tool = ":vite_build_bin",
    visibility = ["//visibility:public"],
)

vitest.vitest_test(
    name = "unit_tests",
    args = [
        "run",
        "--reporter=verbose",
        "--config",
        "$(rootpath vitest.config.ts)",
    ],
    data = [
        "vitest.config.ts",
        ":app_srcs",
        ":node_modules",
        ":node_modules/vitest",
    ],
    tags = ["vitest"],
    visibility = ["//visibility:public"],
)

# Launch-day Member v0 rehearsal: one real PostgreSQL 16.15 test, intentionally
# outside default CI and every Flywheel/RBE/cache lane. `manual` keeps broad
# test suites from selecting it, `local` keeps the database/socket on the
# operator host, and `no-cache` makes every successful invocation fresh proof.
vitest.vitest_test(
    name = "first_membership_rehearsal_test",
    timeout = "long",
    args = [
        "run",
        "$(rootpath src/lib/server/membership/first-membership-rehearsal.integration.test.ts)",
        "--reporter=verbose",
        "--config",
        "$(rootpath vitest.integration.config.ts)",
    ],
    data = [
        "src/lib/server/membership/first-membership-rehearsal.integration.test.ts",
        "vitest.integration.config.ts",
        ":app_srcs",
        ":node_modules",
        ":node_modules/vitest",
    ],
    tags = [
        "integration",
        "local",
        "manual",
        "no-cache",
    ],
    visibility = ["//visibility:public"],
)

js_test(
    name = "playwright_static_smoke",
    timeout = "moderate",
    data = [
        "scripts/bazel/run-playwright-static-smoke.mjs",
        ":build",
        ":e2e_srcs",
        ":node_modules",
    ],
    entry_point = "scripts/bazel/run-playwright-static-smoke.mjs",
    tags = [
        "manual",
        "playwright",
    ],
    visibility = ["//visibility:public"],
)

test_suite(
    name = "ci_validation_suite",
    tests = [
        ":current_source_secret_scan_test",
        ":eslint_test",
        ":prettier_check_test",
        ":svelte_check_test",
        ":unit_tests",
    ],
)

# Historical adapter-static deployment bundle. The v4 application canary does
# not select it because GFTB production is adapter-node; it remains a manual
# local packaging target until an exact production artifact graph replaces it.
pkg_tar(
    name = "deployment_bundle",
    srcs = [":build"],
    extension = "tar.gz",
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

# Container / OCI recipe inventory. Publication is not a v4 Bazel action, and
# the checked-in v4 plan selects neither this target nor the obsolete
# adapter-static deployment bundle. This target grants no publication or
# fallback authority.
pkg_tar(
    name = "container_image_context",
    srcs = [
        "ContainerFile",
        "flake.lock",
        "flake.nix",
        "nix/oci-image.nix",
        "package.json",
        "pnpm-lock.yaml",
        # The three stable process names (web/worker/migrator) are part of the
        # image contract, so the dispatcher is part of the image input set: a
        # change to it must invalidate the container context (TIN-3815 S0).
        "scripts/platform-entrypoint.mjs",
        "svelte.config.js",
    ],
    extension = "tar",
    tags = [
        "container-image-and-push",
        "manual",
    ],
    visibility = ["//visibility:public"],
)

exports_files(
    [
        "MODULE.bazel",
        "package.json",
        "playwright.config.ts",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "scripts/bazel/run-playwright-static-smoke.mjs",
        "scripts/bazel/run-svelte-check.mjs",
        "scripts/bazel/run-sveltekit-sync.mjs",
        "scripts/bazel/run-vite-build.mjs",
        "svelte.config.js",
        "tsconfig.json",
        "vite.config.ts",
        "vitest.config.ts",
    ],
    visibility = ["//visibility:public"],
)
