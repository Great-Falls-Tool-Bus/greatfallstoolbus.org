"""
Root BUILD.bazel for greatfallstoolbus.org.

The SvelteKit adapter-node product has ergonomic pnpm-backed Justfile recipes,
while Bazel owns the finite graphable actions submitted through Flywheel.
"""

load("@aspect_bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_run_binary", "js_test")
load("@aspect_rules_js//npm:defs.bzl", "npm_link_package")
load("@npm//:defs.bzl", "npm_link_all_packages", "npm_link_targets")
load("@npm//:esbuild/package_json.bzl", esbuild_bin = "bin")
load("@npm//:eslint/package_json.bzl", eslint_bin = "bin")
load("@npm//:prettier/package_json.bzl", prettier_bin = "bin")
load("@npm//:vitest/package_json.bzl", vitest = "bin")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//:gitleaks_test.bzl", "gitleaks_test")

npm_link_all_packages(name = "node_modules")

# First-party packages are sourced only from the tinyland-inc/bazel-registry
# Bzlmod graph. package.json and pnpm-lock.yaml deliberately carry no
# @tummycrypt/@tinyland source edge.
npm_link_package(
    name = "node_modules/@tummycrypt/tinyland-auth",
    src = "@tummycrypt_tinyland_auth//:pkg",
)

npm_link_package(
    name = "node_modules/@tummycrypt/tinyland-auth-pg",
    src = "@tummycrypt_tinyland_auth_pg//:pkg",
)

npm_link_package(
    name = "node_modules/@tummycrypt/tinyland-color-utils",
    src = "@tummycrypt_tinyland_color_utils//:pkg",
)

npm_link_package(
    name = "node_modules/@tummycrypt/tinyvectors",
    src = "@tummycrypt_tinyvectors//:pkg",
)

npm_link_package(
    name = "node_modules/@tummycrypt/vite-plugin-a11y",
    src = "@tummycrypt_vite_plugin_a11y//:pkg",
)

npm_link_package(
    name = "node_modules/@tummycrypt/vite-plugin-skeleton-colors",
    src = "@tummycrypt_vite_plugin_skeleton_colors//:pkg",
)

TINYLAND_HOUSE_PACKAGES = [
    ":node_modules/@tummycrypt/tinyland-auth",
    ":node_modules/@tummycrypt/tinyland-auth-pg",
    ":node_modules/@tummycrypt/tinyland-color-utils",
    ":node_modules/@tummycrypt/tinyvectors",
    ":node_modules/@tummycrypt/vite-plugin-a11y",
    ":node_modules/@tummycrypt/vite-plugin-skeleton-colors",
]

# Only these first-party packages remain external at application runtime. The
# other four house packages are build inputs whose code/assets are already in
# the adapter-node output. This list mirrors flake.nix's runtime import proof.
TINYLAND_RUNTIME_HOUSE_PACKAGES = [
    ":node_modules/@tummycrypt/tinyland-auth",
    ":node_modules/@tummycrypt/tinyland-auth-pg",
]

# Direct production links plus each link's transitive store closure. Selecting
# labels rather than the catch-all :node_modules target prevents test, lint,
# bundler, and other devDependencies from entering the publication input.
PRODUCTION_NODE_MODULES = npm_link_targets(
    name = "node_modules",
    dev = False,
    prod = True,
)

filegroup(
    name = "app_srcs",
    srcs = glob(
        [
            "src/**",
            "static/**",
            "scripts/**/*.js",
            "scripts/**/*.mjs",
            "scripts/**/*.mts",
            # Generated + hand-written migrations (TIN-3817 S1). Enrolled so a
            # change to a migration invalidates //:unit_tests — the ledger
            # assertions in src/lib/server/db/migrations.test.ts read this tree,
            # and a cached green from before the edit would defeat them.
            "drizzle/**",
        ],
        allow_empty = True,
    ) + [
        ".npmrc",
        # Read by src/lib/server/db/migrations.test.ts, which asserts that no
        # recipe invokes `drizzle push`.
        "Justfile",
        "drizzle.config.ts",
        "eslint.config.ts",
        "vitest.integration.config.ts",
        "package.json",
        "playwright.config.ts",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "svelte.config.js",
        "server.js",
        "tsconfig.json",
        "vite.config.ts",
        "vitest.config.ts",
    ],
)

# Complete checked-in source capsule for commands whose declared scope is the
# repository root (`eslint .`, `prettier --check .`, and current-source
# Gitleaks). Keep top-level files explicit so a new authority surface cannot
# silently join an action; directory families are globbed because those trees
# are intentionally open-ended source collections.
filegroup(
    name = "current_tracked_source_srcs",
    srcs = [
        ".bazelignore",
        ".bazelrc",
        ".bazelversion",
        ".dockerignore",
        ".editorconfig",
        ".envrc",
        ".gitignore",
        ".gitleaks.toml",
        ".npmrc",
        ".nvmrc",
        ".prettierignore",
        ".prettierrc",
        "AGENTS.md",
        "BUILD.bazel",
        "CHANGELOG.md",
        "CLAUDE.md",
        "Justfile",
        "LICENSE",
        "LICENSE-content",
        "MODULE.bazel",
        "MODULE.bazel.lock",
        "NOTICE",
        "README.md",
        "RELEASING.md",
        "SECURITY.md",
        "cliff.toml",
        "drizzle.config.ts",
        "eslint.config.ts",
        "flake.lock",
        "flake.nix",
        "gitleaks_test.bzl",
        "multitool.lock.json",
        "package.json",
        "playwright.config.ts",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "secrets.contract.yaml",
        "server.js",
        "svelte.config.js",
        "tinyland.repo.json",
        "tsconfig.json",
        "vite.config.ts",
        "vitest.config.ts",
        "vitest.integration.config.ts",
    ] + glob(
        [
            ".agents/**",
            ".claude/**",
            ".github/**",
            "docs/**",
            "drizzle/**",
            "e2e/**",
            "nix/**",
            "plugins/**",
            "scripts/**",
            "src/**",
            "static/**",
            "tofu/**",
        ],
        allow_empty = True,
        exclude = [
            "**/.DS_Store",
            "**/__pycache__/**",
        ],
    ),
)

filegroup(
    name = "e2e_srcs",
    srcs = glob(
        ["e2e/**"],
        allow_empty = True,
    ),
)

# The v4 validation action carries its own exact source capsule. Secret
# scanning is therefore a hermetic Bazel test inside the same REAPI action,
# not a second runner job or a local/hosted fallback.
filegroup(
    name = "current_source_secret_scan_srcs",
    srcs = [":current_tracked_source_srcs"],
)

gitleaks_test(
    name = "current_source_secret_scan_test",
    timeout = "short",
    srcs = [":current_source_secret_scan_srcs"],
    config = ".gitleaks.toml",
    required_paths = [
        ".bazelignore",
        ".claude/skills/tinyland-whoami/SKILL.md",
        ".dockerignore",
        ".editorconfig",
        "CHANGELOG.md",
        "LICENSE-content",
        "NOTICE",
        "RELEASING.md",
        "SECURITY.md",
        "cliff.toml",
        "eslint.config.ts",
        "plugins/scaffold-core/plugin.json",
        "scripts/build-agent-skills.mjs",
        "scripts/discuss-reconcile.mts",
        "scripts/optimize-images.js",
        "secrets.contract.yaml",
        "server.js",
        "tofu/dns-intent/intent.yaml",
    ],
)

js_binary(
    name = "sveltekit_sync_bin",
    data = [":node_modules"] + TINYLAND_HOUSE_PACKAGES,
    entry_point = "scripts/bazel/run-sveltekit-sync.mjs",
)

js_run_binary(
    name = "sveltekit_types",
    srcs = [":app_srcs"],
    out_dirs = [".svelte-kit"],
    tool = ":sveltekit_sync_bin",
)

js_binary(
    name = "svelte_check_bin",
    data = [":node_modules"] + TINYLAND_HOUSE_PACKAGES,
    entry_point = "scripts/bazel/run-svelte-check.mjs",
)

js_test(
    name = "svelte_check_test",
    timeout = "long",
    data = [
        ":app_srcs",
        ":node_modules",
        ":sveltekit_types",
    ] + TINYLAND_HOUSE_PACKAGES,
    entry_point = "scripts/bazel/run-svelte-check.mjs",
)

# Exact, read-only lint target selected by the v4 ActionPlan.
eslint_bin.eslint_test(
    name = "eslint_test",
    timeout = "moderate",
    args = ["."],
    data = [
        "eslint.config.ts",
        ":current_tracked_source_srcs",
        ":node_modules",
        ":node_modules/@eslint/js",
        ":sveltekit_types",
    ] + TINYLAND_HOUSE_PACKAGES,
)

# Exact, read-only format target selected by the v4 ActionPlan.
prettier_bin.prettier_test(
    name = "prettier_check_test",
    timeout = "short",
    args = [
        "--check",
        ".",
    ],
    data = [
        ".prettierignore",
        ".prettierrc",
        ":current_tracked_source_srcs",
        ":node_modules",
    ] + TINYLAND_HOUSE_PACKAGES,
)

js_binary(
    name = "vite_build_bin",
    data = [":node_modules"] + TINYLAND_HOUSE_PACKAGES,
    entry_point = "scripts/bazel/run-vite-build.mjs",
)

js_run_binary(
    name = "build",
    srcs = [
        ":app_srcs",
        ":sveltekit_types",
    ],
    out_dirs = ["build"],
    patch_node_fs = False,
    tool = ":vite_build_bin",
    visibility = ["//visibility:public"],
)

# Exact Bazel counterparts of the developer-facing Just recipes. Both are
# single-file Node 24 ESM payloads so the worker and migrator do not depend on
# the web process's module-resolution layout.
esbuild_bin.esbuild(
    name = "migrator_bundle",
    args = [
        "src/lib/server/db/migrate.ts",
        "--bundle",
        "--platform=node",
        "--format=esm",
        "--target=node24",
        "--outfile=$@",
        "--external:pg-native",
        "--external:cloudflare:sockets",
        "--tsconfig-raw={}",
        "--banner:js=import { createRequire as __gftbCreateRequire } from 'node:module'; const require = __gftbCreateRequire(import.meta.url);",
    ],
    outs = ["bazel-role-bundles/migrator.mjs"],
    srcs = [
        ":app_srcs",
        ":node_modules",
    ] + TINYLAND_HOUSE_PACKAGES,
    tags = ["manual"],
)

esbuild_bin.esbuild(
    name = "worker_bundle",
    args = [
        "src/lib/server/worker.ts",
        "--bundle",
        "--platform=node",
        "--format=esm",
        "--target=node24",
        "--outfile=$@",
        "--external:pg-native",
        "--external:cloudflare:sockets",
        "--alias:$$lib=./src/lib",
        "--tsconfig-raw={}",
        "--banner:js=import { createRequire as __gftbCreateRequire } from 'node:module'; const require = __gftbCreateRequire(import.meta.url);",
    ],
    outs = ["bazel-role-bundles/worker.mjs"],
    srcs = [
        ":app_srcs",
        ":node_modules",
    ] + TINYLAND_HOUSE_PACKAGES,
    tags = ["manual"],
)

vitest.vitest_test(
    name = "unit_tests",
    args = [
        "run",
        "--reporter=verbose",
        "--config",
        "$(rootpath vitest.config.ts)",
    ],
    data = [
        "BUILD.bazel",
        "MODULE.bazel",
        "MODULE.bazel.lock",
        "vitest.config.ts",
        ":app_srcs",
        ":node_modules",
        ":node_modules/vitest",
    ] + TINYLAND_HOUSE_PACKAGES,
    tags = ["vitest"],
    visibility = ["//visibility:public"],
)

# Launch-day Member v0 rehearsal: one real PostgreSQL 16.15 test, intentionally
# outside default CI and every Flywheel/RBE/cache lane. `manual` keeps broad
# test suites from selecting it, `local` keeps the database/socket on the
# operator host, and `no-cache` makes every successful invocation fresh proof.
vitest.vitest_test(
    name = "first_membership_rehearsal_test",
    timeout = "long",
    args = [
        "run",
        "$(rootpath src/lib/server/membership/first-membership-rehearsal.integration.test.ts)",
        "--reporter=verbose",
        "--config",
        "$(rootpath vitest.integration.config.ts)",
    ],
    data = [
        "src/lib/server/membership/first-membership-rehearsal.integration.test.ts",
        "vitest.integration.config.ts",
        ":app_srcs",
        ":node_modules",
        ":node_modules/vitest",
    ] + TINYLAND_HOUSE_PACKAGES,
    tags = [
        "integration",
        "local",
        "manual",
        "no-cache",
    ],
    visibility = ["//visibility:public"],
)

# Finite, hermetic Node enrollment for the fail-closed first-party package
# authority gate. Its inputs are explicit and it runs inside the same v4
# validation action as the product tests; there is no host-Python dependency.
js_test(
    name = "inhouse_package_parity_test",
    data = [
        ":node_modules",
        "BUILD.bazel",
        "MODULE.bazel",
        "package.json",
        "pnpm-lock.yaml",
    ] + TINYLAND_HOUSE_PACKAGES,
    entry_point = "scripts/check-inhouse-package-parity.mjs",
    tags = ["supply-chain-contract"],
)

test_suite(
    name = "ci_validation_suite",
    tests = [
        ":current_source_secret_scan_test",
        ":eslint_test",
        ":inhouse_package_parity_test",
        ":prettier_check_test",
        ":svelte_check_test",
        ":unit_tests",
    ],
)

# Materialize the complete, runnable application root. copy_to_directory
# intentionally dereferences rules_js's node_modules symlinks, then omits the
# now-redundant private store: the exported tree is standalone rather than a
# set of links back into a Bazel execroot. A duplicate destination fails closed.
copy_to_directory(
    name = "deployment_app_root",
    srcs = [
        ":build",
        ":migrator_bundle",
        ":worker_bundle",
        "package.json",
        "scripts/platform-entrypoint.mjs",
        "server.js",
    ] + glob(
        ["drizzle/**"],
    ) + PRODUCTION_NODE_MODULES + TINYLAND_RUNTIME_HOUSE_PACKAGES,
    exclude_srcs_patterns = [
        "node_modules/.aspect_rules_js/**",
    ],
    replace_prefixes = {
        "bazel-role-bundles": "build",
    },
    root_paths = ["."],
    tags = ["manual"],
)

# Reproducible publication input rooted at app/. It is deliberately only an
# artifact: image construction, registry publication, and promotion remain
# separate owner-authorized transactions outside this application repository.
pkg_tar(
    name = "deployment_bundle",
    srcs = [":deployment_app_root"],
    extension = "tar.gz",
    package_dir = "app",
    strip_prefix = "deployment_app_root",
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

exports_files(
    [
        "MODULE.bazel",
        "package.json",
        "playwright.config.ts",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "scripts/bazel/run-svelte-check.mjs",
        "scripts/bazel/run-sveltekit-sync.mjs",
        "scripts/bazel/run-vite-build.mjs",
        "svelte.config.js",
        "tsconfig.json",
        "vite.config.ts",
        "vitest.config.ts",
    ],
    visibility = ["//visibility:public"],
)
