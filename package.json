{
	"name": "greatfallstoolbus",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Great Falls Tool Bus app-stateful platform (SvelteKit + Bazel + Nix + Just)",
	"homepage": "https://github.com/Great-Falls-Tool-Bus/greatfallstoolbus.org",
	"repository": {
		"type": "git",
		"url": "https://github.com/Great-Falls-Tool-Bus/greatfallstoolbus.org.git"
	},
	"license": "MIT",
	"packageManager": "pnpm@10.13.1",
	"engines": {
		"node": ">=22 <25"
	},
	"scripts": {
		"prepare": "node scripts/build-tinyvectors.mjs",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest",
		"test:unit": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"optimize:images": "node scripts/optimize-images.js",
		"analyze": "ANALYZE=1 vite build"
	},
	"dependencies": {
		"@fontsource-variable/fira-code": "^5.3.0",
		"@fontsource-variable/fraunces": "^5.3.0",
		"@fontsource/crimson-pro": "^5.3.0",
		"@fontsource/inter": "^5.3.0",
		"@lucide/svelte": "^1.33.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@tummycrypt/tinyland-auth": "0.3.3",
		"@tummycrypt/tinyland-auth-pg": "0.2.4",
		"@tummycrypt/tinyland-color-utils": "0.2.3",
		"@tummycrypt/tinyvectors": "https://github.com/tinyland-inc/tinyvectors/archive/refs/tags/v0.3.7.tar.gz",
		"drizzle-orm": "0.39.3",
		"effect": "^3.22.1",
		"pg": "^8.20.0",
		"stripe": "^22.5.0"
	},
	"devDependencies": {
		"@playwright/test": "^1.62.1",
		"@skeletonlabs/skeleton": "4.15.2",
		"@skeletonlabs/skeleton-svelte": "4.15.2",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@testcontainers/postgresql": "^12.1.0",
		"@tummycrypt/vite-plugin-a11y": "0.2.2",
		"@tummycrypt/vite-plugin-skeleton-colors": "0.2.2",
		"@types/node": "^22.20.1",
		"@types/pg": "^8.20.0",
		"@vitest/coverage-v8": "^4.1.11",
		"drizzle-kit": "^0.30.5",
		"esbuild": "^0.28.2",
		"eslint": "^9.39.4",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.11.0",
		"mdsvex": "0.12.8",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"rollup-plugin-visualizer": "^7.1.1",
		"serve": "^14.2.6",
		"sharp": "^0.35.3",
		"shiki": "^4.4.3",
		"svelte": "^5.56.10",
		"svelte-check": "^4.7.6",
		"svgo": "^4.0.2",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.12",
		"typescript": "6.0.3",
		"typescript-eslint": "^8.67.0",
		"vite": "^8.2.2",
		"vitest": "^4.1.11"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@tailwindcss/oxide",
			"esbuild",
			"sharp"
		]
	}
}
